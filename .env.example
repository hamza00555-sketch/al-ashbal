# Copy this file to .env and fill in your key (or set it as an environment variable).
# Used by the gpt-image-2 skill (.claude/skills/gpt-image-2/).
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=your-fal-ai-key-here

# ---------------------------------------------------------------------------
# Supabase backend (Phase 1a foundation — NOT wired to the app yet).
# The app still runs entirely on localStorage; these are placeholders for the
# upcoming backend phases. See supabase/README.md.
# ---------------------------------------------------------------------------

# CLIENT-SAFE (sent to the browser; RLS-bound):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY SECRET — NEVER expose to the browser / client code. Bypasses RLS.
# Use only in server actions / Edge Functions. Do NOT prefix with NEXT_PUBLIC_.
# In Vercel: add this as a SERVER-only Environment Variable (do NOT make it
# available to the client / Preview client bundle). Only NEXT_PUBLIC_* vars are
# ever exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for recordings (private bucket; see migration 008).
SUPABASE_STORAGE_BUCKET_RECORDINGS=recordings

# CLIENT-SAFE — used to build /join links + auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL, SERVER-ONLY — extra "pepper" mixed into child-grant token hashing
# (Phase 5). If set, a DB leak of grant_token_hash alone can't be brute-forced.
# Never prefix with NEXT_PUBLIC_. Leave blank for MVP (plain SHA-256 of a
# high-entropy token). See src/lib/backend/childDeviceGrants.ts.
CHILD_GRANT_TOKEN_PEPPER=
